doc() {
  docker-compose run web $@
}

connect_ssh_with_env() {
  local user_env_var="$1"
  local host_env_var="$2"
  local user_value host_value

  if [ -z "$user_env_var" ] || [ -z "$host_env_var" ]; then
    echo "Error: connect_ssh_with_env requires user and host env var names" >&2
    return 1
  fi

  user_value="${(P)user_env_var}"
  host_value="${(P)host_env_var}"

  if [ -z "${user_value:-}" ]; then
    echo "Error: ${user_env_var} is not set" >&2
    return 1
  fi
  if [ -z "${host_value:-}" ]; then
    echo "Error: ${host_env_var} is not set" >&2
    return 1
  fi

  ssh "${user_value}@${host_value}"
}

pi() {
  connect_ssh_with_env "PIHOLE_SSH_USER" "PIHOLE_SSH_IP"
}

hs-m() {
  connect_ssh_with_env "HOMESERVER_SSH_USER" "HOMESERVER_MONITORING_SSH_IP"
}

hs-oc() {
  connect_ssh_with_env "HOMESERVER_SSH_USER" "HOMESERVER_OPENCLAW_SSH_IP"
}