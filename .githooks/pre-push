#!/usr/bin/env sh

set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' 'gitleaks is required for this repository. Install it first to continue.' >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

printf '%s\n' 'Running gitleaks secret scan before push...'
gitleaks git --no-banner --redact .
