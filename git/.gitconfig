[user]
	name = Sam Younger
	email = syounger@usertesting.com
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
  gpgsign = true
[core]
	excludesfile = "~/.gitignore_global"
[alias]
	goodmorning = !zsh -c \"source ~/.zshrc"
[pull]
  rebase = false
# Enforce SSH
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
