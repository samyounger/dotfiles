[user]
  name = Sam Younger
  email = samyounger@fastmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGAlHTOWv6dTS5TKBjYtxnzL/qU14qjk7fQE6Q/R3JrQ
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
  gpgsign = true
[core]
  excludesfile = "~/.dotfiles/git/.gitignore_global"
[pull]
  rebase = false
# Enforce SSH
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
